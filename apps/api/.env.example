NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rdn:rdn_local@localhost:5432/rdn_dev?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RDNAPP
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=5
AWS_REGION=ap-south-1
AWS_S3_BUCKET=rdn-uploads-dev
AWS_CLOUDFRONT_URL=https://cdn.example.com
AWS_SES_FROM_EMAIL=noreply@rdn.com
# For S3-compatible providers (e.g., Cloudflare R2). Leave unset for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=
ALLOWED_ORIGINS=http://localhost:3000
# Set to "true" to allow any 6-digit OTP (UAT/dev). NEVER set in production.
# The API refuses to boot if this is "true" while NODE_ENV=production.
OTP_DEV_BYPASS=

# --- Razorpay (commission settlement / payments) — REQUIRED in prod ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging (push notifications) — REQUIRED in prod ---
# JSON service-account key (stringified) or path, per notifications module.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# --- Sentry (API error tracking) — recommended in prod ---
# When unset, Sentry is a no-op. Set the DSN to enable error reporting.
SENTRY_DSN=

# NOTE: In production JWT_SECRET and JWT_REFRESH_SECRET MUST be set to strong,
# unique values. The API refuses to boot in prod if either is missing.
